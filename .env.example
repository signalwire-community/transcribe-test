# --- SignalWire credentials -------------------------------------------------
# Just the space subdomain, e.g. "example" for example.signalwire.com
SIGNALWIRE_SPACE=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=

# --- App ---------------------------------------------------------------------
PORT=3000
# Public HTTPS base URL SignalWire can reach (ngrok, Cloudflare tunnel, etc.)
# No trailing slash.
PUBLIC_BASE_URL=https://your-tunnel.example.com

# --- Test call ---------------------------------------------------------------
# MCI test number
TARGET_NUMBER=+18004444444
# Optional caller ID for the outbound (B) leg. Leave blank to pass through.
FROM_NUMBER=

# --- Transcription -----------------------------------------------------------
TRANSCRIBE_LANG=en-US
TRANSCRIBE_ENGINE=deepgram
# true = emit partial results as they happen
TRANSCRIBE_LIVE_EVENTS=true
# true = generate an AI summary when the session ends
TRANSCRIBE_AI_SUMMARY=false
